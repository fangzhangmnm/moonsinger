{
  // 类型检查专用（tsc --noEmit）——抄 CatsUp（created 2026-10-06 by Claude Opus 5.5）。
  // 运行时 node 24 strip-types 直跑 test/，试验页由 esbuild bundle；import 写 .ts 扩展名。
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    // type-only import 必须写 `import type`，否则 strip-types 运行时报「does not provide an export」。
    "verbatimModuleSyntax": true,
    "types": [],
    "forceConsistentCasingInFileNames": true,
    // 开发期直连共享库源码（@internal/model-packs 还没发版；发 0.1.0 后改成 vendor-pkgs 收货、删掉这条和 build.sh 的 alias）
    "paths": { "@internal/model-packs": ["../20261007 internal-model-packs/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["Lab", "node_modules", ".claude", "tools"]
}
