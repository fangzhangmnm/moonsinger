{
  "name": "moonsinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "comment": "created 2026-10-06 by Claude Opus 5.5（编辑器第一版：试验页，抄 CatsUp 工具链）。运行时依赖只有 vendored 的家族内部库（vendor-pkgs/*.tgz，用库的 scripts/pull-package.sh 收货）；node 24 strip-types 直跑 test/；devDependencies 仅供 tsc --noEmit 类型门。版本 SSoT = src/version.ts。",
  "scripts": {
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "build": "bash scripts/build.sh",
    "serve": "bash scripts/serve.sh",
    "smoke": "node test/shell-smoke.mjs && node test/file-smoke.mjs",
    "e2e": "npm run build && node test/e2e/run.mjs",
    "render": "node scripts/render-song.mjs",
    "e2e:changed": "npm run build && node test/e2e/run.mjs --changed",
    "test:full": "npm run check && node test/e2e/run.mjs --smoke"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@internal/model-packs": "file:./vendor-pkgs/internal-model-packs-0.1.0.tgz",
    "@internal/read-aloud": "file:./vendor-pkgs/internal-read-aloud-0.1.22.tgz",
    "@internal/workbench-elements": "file:./vendor-pkgs/internal-workbench-elements-0.1.3.tgz",
    "@internal/store": "file:./vendor-pkgs/internal-store-2.2.0.tgz",
    "@internal/encryption": "file:./vendor-pkgs/internal-encryption-0.1.0.tgz",
    "@internal/gallery": "file:./vendor-pkgs/internal-gallery-0.8.7.tgz",
    "@internal/reference-window": "file:./vendor-pkgs/internal-reference-window-0.5.0.tgz"
  }
}
